// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compose: tools > the tool list is pinned 1`] = `
[
  {
    "description": "Hold an appointment for 5 minutes and get the readback. Use serviceIds (service ids preferred; an exact service name or alias also works), staffId (a staff id or 'any') and a start time from check_availability, plus the customer's name and phone. Read the returned readback to the caller word for word and call scheduling.book.commit only after an explicit yes. If the caller changes anything, call prepare again (the earlier hold is released). On CONFLICT, offer the alternatives. On SLOT_MISSING, ask the caller the one question in callerSafeMessage; if exit is set, offer to take a message.",
    "name": "scheduling_book_prepare",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "customer": {
          "additionalProperties": false,
          "properties": {
            "email": {
              "format": "email",
              "maxLength": 255,
              "type": "string",
            },
            "name": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string",
            },
            "phone": {
              "maxLength": 32,
              "minLength": 7,
              "type": "string",
            },
          },
          "type": "object",
        },
        "notes": {
          "maxLength": 1000,
          "type": "string",
        },
        "serviceIds": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
