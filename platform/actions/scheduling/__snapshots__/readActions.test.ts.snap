// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`scheduling.check_availability > generates a stable agent tool schema 1`] = `
{
  "actionName": "scheduling.check_availability",
  "agentDescription": "Find open appointment times for 1 to 3 services done back-to-back by one staff member. serviceIds: service ids from list_services are preferred; an exact service name (or alias) also works. staffId is a staff id from list_staff or 'any'; their exact name also works. Give date (YYYY-MM-DD, the date in the tenant's timezone; get_current_tenant_time gives today's date) or window {from,to} in the same format; with neither it finds the first available day. Optional startTime checks that exact time: slots start there if it is open, else the next open times, earliest first. Use shop-local HH:MM with date, or copy a full ISO timestamp (with Z or an offset) directly from a slot start or blockedUntil without converting it. A timestamp supplies its own shop-local date; any provided date must match. startTime cannot be used with window. Optional partOfDay (morning, afternoon, evening) and limit (max 5). Offer at most 3 slots, saying each slot's spoken text word for word. spoken is already in shop-local time: never work out a time to say from a timestamp, and never convert one (start, end and blockedUntil are UTC; localTime is start with the shop's own offset). blockedUntil is when that staff member is free again (end plus clean-up time). With no slots, say reasonIfNone truthfully and offer nextOpenDate. Re-check if more than 2 minutes pass before booking.",
  "description": "Find open appointment times for 1 to 3 services done back-to-back by one staff member. serviceIds: service ids from list_services are preferred; an exact service name (or alias) also works. staffId is a staff id from list_staff or 'any'; their exact name also works. Give date (YYYY-MM-DD, the date in the tenant's timezone; get_current_tenant_time gives today's date) or window {from,to} in the same format; with neither it finds the first available day. Optional startTime checks that exact time: slots start there if it is open, else the next open times, earliest first. Use shop-local HH:MM with date, or copy a full ISO timestamp (with Z or an offset) directly from a slot start or blockedUntil without converting it. A timestamp supplies its own shop-local date; any provided date must match. startTime cannot be used with window. Optional partOfDay (morning, afternoon, evening) and limit (max 5). Offer at most 3 slots, saying each slot's spoken text word for word. spoken is already in shop-local time: never work out a time to say from a timestamp, and never convert one (start, end and blockedUntil are UTC; localTime is start with the shop's own offset). blockedUntil is when that staff member is free again (end plus clean-up time). With no slots, say reasonIfNone truthfully and offer nextOpenDate. Re-check if more than 2 minutes pass before booking.",
  "name": "scheduling_check_availability",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "date": {
        "type": "string",
      },
      "limit": {
        "maximum": 5,
        "minimum": 1,
        "type": "integer",
      },
      "partOfDay": {
        "enum": [
          "morning",
          "afternoon",
          "evening",
        ],
        "type": "string",
      },
      "serviceIds": {
        "items": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "type": "array",
      },
      "staffId": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string",
      },
      "startTime": {
        "type": "string",
      },
      "window": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
          },
          "to": {
            "type": "string",
          },
        },
        "required": [
          "from",
          "to",
        ],
        "type": "object",
      },
    },
    "required": [
      "serviceIds",
    ],
    "type": "object",
  },
}
`;
