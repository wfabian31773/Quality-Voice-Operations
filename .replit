entrypoint = "src/index.ts"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-25_05"

[unitTest]
language = "nodejs"

[deployment]
run = ["bash", "-c", "npx tsx server/admin-api/start.ts & npx tsx server/voice-gateway/start.ts & wait"]
deploymentTarget = "vm"
ignorePorts = false
build = ["bash", "-c", "npx tsc --noEmit && npm --prefix client-app run typecheck && npm run verify:stripe-prices && npx vite build --config client-app/vite.config.ts"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3003

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 23636
externalPort = 4200

[agent]
expertMode = true
integrations = ["javascript_database:1.0.0", "twilio:1.0.0", "javascript_object_storage:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Platform Dev"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit"

[[workflows.workflow]]
name = "Platform Dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-platform-dev.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run lint -- client-app/src/lib/displayCurrency.ts client-app/src/components/DisplayCurrencyPicker.tsx client-app/src/components/MinutesPricingCalculator.tsx client-app/src/components/ROICalculator.tsx client-app/src/pages/public/Pricing.tsx client-app/src/pages/public/Signup.tsx client-app/src/pages/public/Product.tsx server/admin-api/routes/auth.ts client-app/src/hooks/useTenantCurrency.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run typecheck:client"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "unit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run tests/billing/displayCurrency.test.ts tests/billing/signupBillingCurrency.test.ts tests/marketing/pricingDisplayCurrency.test.tsx 2>&1 | tail -50"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
DISABLE_PHI_LOGGING = "true"
TWILIO_OUTBOUND_NUMBER = "+16263821543"

[userenv.development]
APP_ENV = "development"

[userenv.production]
APP_ENV = "production"
PORT = "5000"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000
