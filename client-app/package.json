{
  "name": "client-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "prebuild": "node ../scripts/generate-sitemap.mjs",
    "build": "npm run build:app && npm run build:public",
    "build:app": "vite build --config vite.config.ts",
    "build:public": "vite build --config vite.public.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "analyze": "vite-bundle-visualizer --config vite.config.ts -o dist/stats.html --open false",
    "analyze:json": "vite-bundle-visualizer --config vite.config.ts -o dist/stats.json --template raw-data --open false",
    "analyze:public": "vite-bundle-visualizer --config vite.public.config.ts -o dist/public/stats.html --open false"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "dompurify": "^3.4.11",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "marked": "^18.0.2",
    "preact": "^10.29.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.9.0",
    "vite": "^6.4.3",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "tmp": "^0.2.7",
    "ws": "^8.21.0"
  }
}
